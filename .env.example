# Copy this file to .env and fill in your values. NEVER commit .env to GitHub.

# ---- WhatsApp Cloud API (from Meta developer dashboard > WhatsApp > API Setup) ----
# Any secret word you choose. Type the same word in Meta's webhook "Verify token" box.
VERIFY_TOKEN=
# Meta app > App settings > Basic > App secret. Used to check webhook signatures.
APP_SECRET=
# Access token (temporary 24h token for testing, or a permanent System User token).
ACCESS_TOKEN=
# "Phone number ID" (NOT the phone number itself).
PHONE_NUMBER_ID=
GRAPH_API_VERSION=v23.0

# ---- AI ----
# gemini (default) or anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_TIMEOUT_SECONDS=25

# ---- Business ----
# Name of the file in business/ without .md (guest-house, dental-clinic, saree-shop)
ACTIVE_BUSINESS=guest-house
# Owner's WhatsApp number with country code, digits only, e.g. 9198xxxxxxxx
OWNER_WHATSAPP=
# Added to 10-digit numbers in owner commands like "#resume 98xxxxxxxx"
DEFAULT_COUNTRY_CODE=91

# ---- Storage / behaviour ----
DATABASE_PATH=data/bot.db
# How many recent messages per customer the bot remembers
MEMORY_LIMIT=15
# Paused chats turn the bot back on automatically after this many hours (0 = never)
PAUSE_HOURS=12
LOG_LEVEL=INFO
